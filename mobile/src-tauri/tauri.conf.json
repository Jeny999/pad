{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pad",
  "version": "0.1.0",
  "identifier": "com.jeny45ton.pad",
  "build": {
    "frontendDist": "../web-pad"
  },
  "app": {
    "windows": [
      {
        "title": "Pad",
        "width": 900,
        "height": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
